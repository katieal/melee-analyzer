    btn_clicked = ctx.triggered_id if type(ctx.triggered_id) == str else ctx.triggered_id.type

    if btn_clicked == 'delete-round-button':
        # get index of triggered button
        if delete_clicks > 0:
            # get index of triggered button
            index = 0
            for i, button in enumerate(ctx.states_list[0]):
                if button['id'] == ctx.triggered_id:
                    index = i
                    break

            # set modal message and open modal
            msg = f"Are you sure you wish to delete round {index + 1}?"
            set_props('confirm-modal-body', {'children': msg})
            set_props('confirm-modal', {'is_open': not open_state})
